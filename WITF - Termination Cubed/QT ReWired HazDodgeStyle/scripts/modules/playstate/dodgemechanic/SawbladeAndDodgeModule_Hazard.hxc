class SawbladeAndDodgeModule_HazardVersion extends Module
{
  // Editable config values:
  var soundStyle(get, null):String;
  function get_soundStyle():String
  {
    var optionsModule = ModuleHandler.getModule("QT_Hazard_OptionsCategory");
    if(optionsModule!=null){
      return optionsModule.getSaveData_sawbladeSFX();
    }else{
      return "brutal";
    }
  }

  var RATE_PITCH_SHIFT(get, null):Bool;
  function get_RATE_PITCH_SHIFT():Bool
  {
    var optionsModule = ModuleHandler.getModule("QT_Hazard_OptionsCategory");
    if(optionsModule!=null){
      return optionsModule.getSaveData_sawbladePitchRate();
    }else{
      return true;
    }
  }

  // Change this to any number to override the maxSawHits. Otherwise, defaults to using the integer defined in the preferences menu.
  public var maxSawHitsOverride(default, set):Int = -2;
  function set_maxSawHitsOverride(newValue:Int):Int
  {
    maxSawHitsOverride = newValue;
    sawHits = sawHits; // force update sawHits counter text
    return newValue;
  }


  var maxSawHits(get, null):Int;
  function get_maxSawHits():Int
  {
    if(maxSawHitsOverride >= -1){
      return maxSawHitsOverride;
    }
    var optionsModule = ModuleHandler.getModule("QT_Hazard_OptionsCategory");
    if(optionsModule!=null){
      return optionsModule.getSaveData_sawbladeLimit();
    }else{
      return 4;
    }
  }

  // To punish those who dodge early (because in OG QT, you can cheese sawblades by dodging every beat).
  // Stings, doesn't it?
  function getDodgeCooldownDuration():Float{
    var beatLengthMs = Conductor.instance.beatLengthMs;
    
    // For really slow BPM's, we add a maximum cap to the beatLength.
    var lowBPM:Float = 170;
    var lowBeatLengthMs = 60/lowBPM*Constants.MS_PER_SEC;
    beatLengthMs = Math.min(beatLengthMs, lowBeatLengthMs);
    //trace(beatLengthMs);

    return beatLengthMs*2.35;
  }

  static inline var playHitSnd:Bool = true;
  static inline var playDodgeSnd:Bool = true;
  static inline var sawbladeScoreDODGE:Int = 500;
  static inline var sawbladeScoreMISS:Int = -500;


  // Config ends


  var bfDodgeCooldownMultiplier:Float = 1.0; // When getting hit, the cooldown duration expires much quicker to help prevent note locking.
  var bfDodging:Bool = false;
  var dodgeToggleAnim(default, set):Int = 0;
  function set_dodgeToggleAnim(newValue:Int):Int
  {
    dodgeToggleAnim = newValue;
    return newValue;
  }


