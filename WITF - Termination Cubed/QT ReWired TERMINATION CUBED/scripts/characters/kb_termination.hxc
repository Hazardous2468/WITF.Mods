package rewired.characters;

import funkin.play.PlayState;
import funkin.play.character.MultiAnimateAtlasCharacter;
import flixel.FlxG;
import animate.internal.elements.FlxSpriteElement;
import funkin.graphics.FunkinSprite;
import funkin.play.stage.Bopper;
import funkin.util.assets.FlxAnimationUtil;
import funkin.audio.FunkinSound;
import StringTools;

class KillerByteTerminationCharacter extends MultiAnimateAtlasCharacter
{
  function new()
  {
    super('kb_termination');
  }

  public var eyes:FunkinSprite;
  var eyesOffsetX:Float = 254-3;
  var eyesOffsetY:Float = 275-44-26;

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    if(PlayState.instance!=null && PlayState.instance.currentStage != null){
      eyes = new Bopper();
      eyes.shouldBop = false;
      eyes.zIndex = 305;
      //eyes.loadTextureAtlas("characters/kb_export/eyes", "shared");
      eyes.loadTextureAtlas("characters/kb_termination/kb_rewired_edit_eyes", "shared");
      FlxAnimationUtil.addTextureAtlasAnimations(eyes, _data.animations);
      for (anim in _data.animations) (anim.offsets == null)
      ?eyes.setAnimationOffsets
      (anim.name, 0, 0) : eyes.setAnimationOffsets
      (anim.name, anim.offsets[0], anim.offsets[1]);
    
      eyes.setPosition(this.x + eyesOffsetX, this.y + eyesOffsetY);
      PlayState.instance.currentStage.add(eyes);
      PlayState.instance.currentStage.refresh();
    }
    this.ignoreExclusionPref = ["bluescreen-recover"];
  }

  public override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    if(StringTools.contains(name, "sing")){ // Make sing cancel out special anims.
      this.canPlayOtherAnims = true;
    }
    super.playAnimation(name, restart, ignoreOther, reversed);
    if (eyes != null)
    {
      if(!this.active){
        eyes.visible = false;
        return;
      }

      if (name == "scream" || name == "break" || name == "break-hold" || name == "intro-erect" || name == "tsundere" || this.animation.curAnim.name == "tsundere")
      {
        eyes.visible = false;
        return;
      }
      else{
        eyes.visible = true;
      }

      var curEyesAnimation:String = eyes.getCurrentAnimation();
      if ((curEyesAnimation == "scream" || curEyesAnimation == "bluescreen-recover" || curEyesAnimation == "break" || curEyesAnimation == "break-hold") && name == "idle")
      {
        //ignoreOther = false;
        return;
      }
      eyes.playAnimation(name, restart, ignoreOther);
      eyes.setPosition(this.x + eyesOffsetX, this.y + eyesOffsetY);
    }
  }

  override function onAnimationFinished(name:String)
  {
    switch (name)
    {
      case "break":
        playAnimation('break-hold');
        this.canPlayOtherAnims = false;

      case "intro-erect":
        playAnimation('singLEFT', false, false, false);
        this.canPlayOtherAnims = true;
        playAnimation('idle');

      case "tsundere":
        this.canPlayOtherAnims = false;
        holdTimer -= 99999;
        return;
    }
    super.onAnimationFinished(name);
  }
}
