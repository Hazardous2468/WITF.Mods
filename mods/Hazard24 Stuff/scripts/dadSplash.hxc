package hazard24.modules.play;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.util.Constants;
import StringTools;
import flixel.FlxG;
import funkin.modding.module.ModuleHandler;


class DadSplash extends Module {
	var enabled:Bool = true;
	var isWITF:Bool = false;
    function new() {
        // Load the mod
		super("DadSplash", 99, {
          state: PlayState
        });
        isWITF = Constants.TITLE.toUpperCase() == "WHAT IN THE FUNKIN'";
    }

	override function onCountdownStart(event) {
		super.onCountdownStart(event);

		var optionsModule = ModuleHandler.getModule("DadSplashOption");
		if(optionsModule!=null){
			enabled = optionsModule.getSaveData_DadSplashes();
		}else{
			trace("[DAD NOTE SPLASHES] Options Module could not be found.");
		}
	}

	var ignoredNoteKinds:Array<String> = ['hurt', 'fake', 'kb_miss', 'trickyhell', 'trickydeath'];


    override function onNoteHit(event) {
        super.onNoteHit(event);
        if (event.eventCanceled) return;
        if(!enabled) return;
		
        // Dad notes are always perfect and give 0 score
        //var dadNote = event.score == 0 && event.judgement == 'perfect';
        //if (!dadNote) return;

        // We a BF note, we don't care.
        //if (event.note.noteData.getMustHitNote()) return;

		var note = event.note;

		// Play the note splash for the opponent
		var playState = PlayState.instance;
		if(playState == null) return;
		var strumline = playState.opponentStrumline;
		if (event.note.noteData.getMustHitNote()) strumline = playState.playerStrumline;
		if(strumline != null && !ignoredNoteKinds.contains(note.noteData.kind)){
			if(isWITF && note.weBelongTo != null)
				note.weBelongTo.playNoteSplash(note.direction, note);
			else
				strumline.playNoteSplash(note.direction, note);	
		}
		
    }
}
