package rewired.events;

import flixel.FlxG;
import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.event.SongEvent;
import funkin.Conductor;

// Added here so that this event can appear with the other events in the chart editor, as well as preventing crashes.

class ChangeStageEventQT extends SongEvent
{
  public function new()
  {
    super('changeStage', {
      processOldEvents: true
    });
  }

  public override function handleEvent(data:SongEventData):Void
  {
    return;
  }

  public override function getTitle():String
  {
    return "Change Stage (QT ReWired)";
  }

  public override function getIconPath():String
  {
    return 'ui/chart-editor/events/changeStage';
  }

  override public function getEventSchema()
  {
    var stage_schema = {
      name: "char",
      title: "Type",
      type: "enum",
      keys: [
        "Static" => "Killer",
        "Warning (Red)" => "Red",
        "Bluescreen" => "Blue"
      ],
      defaultValue: "Killer"
    };
    return [stage_schema];
  }
}
