            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              dodgeModule.doSawAnimation(false);
              dodgeModule.playWarningStepVFX("alert 1-2 beat 3");
              _trace('[SAWBLADE] Third Warning.');
            }
          },
          {
            beat: 3,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 1-2 beat 4");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, true);
              _trace('[SAWBLADE] Fourth Warning.');
            }
          },
          {
            beat: 4,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX('alert 1-2 attack 1');
              _trace('[SAWBLADE] Attack Long Single!');
            }
          }
        ];


      case 4:
        [
          {
            beat: 0,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              if(!dodgeModule.useScrollUI) dodgeModule.darkenScreen();
              dodgeModule.playWarningStepVFX("alert 4 beat 1");
              _trace('[SAWBLADE] INCOMING QUADRUPLE!');
              _trace('[SAWBLADE] First Warning.');
              _trace('[SAWBLADE] HitTime: ${hitTimes[0]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[1]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[2]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[3]}');
            }
          },
          {
            beat: 1,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(4, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 4 beat 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, false);
              _trace('[SAWBLADE] Second Warning.');
            }
          },
          {
            beat: 2,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 4 attack 1");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 1, true);
              _trace('[SAWBLADE] Attack Quadruple First!');
            }
          },
          {
            beat: 3,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(2, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 4 attack 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 2, true);
              _trace('[SAWBLADE] Attack Quadruple Second!');
            }
          },
          {
            beat: 4,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(3, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 4 attack 3");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 3, true);
              _trace('[SAWBLADE] Attack Quadruple Second!');
            }
          },
          {
            beat: 5,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(4, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 4 attack 4");
              _trace('[SAWBLADE] Attack Quadruple Fourth!');
            }
          }
        ];


      case 3:
        [
          {
            beat: 0,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              if(!dodgeModule.useScrollUI) dodgeModule.darkenScreen();
              dodgeModule.playWarningStepVFX("alert 3 beat 1");
              _trace('[SAWBLADE] INCOMING TRIPLE!');
              _trace('[SAWBLADE] First Warning.');
              _trace('[SAWBLADE] HitTime: ${hitTimes[0]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[1]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[2]}');
            }
          },
          {
            beat: 1,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(3, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 3 beat 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, false);
              _trace('[SAWBLADE] Second Warning.');
            }
          },
          {
            beat: 2,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 3 attack 1");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 1, true);
              _trace('[SAWBLADE] Attack Triple First!');
            }
          },
          {
            beat: 3,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(2, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 3 attack 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 2, true);
              _trace('[SAWBLADE] Attack Triple Second!');
            }
          },
          {
            beat: 4,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(3, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 3 attack 3");
              _trace('[SAWBLADE] Attack Triple Third!');
            }
          }
        ];


      case 2:
        [
          {
            beat: 0,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              if(!dodgeModule.useScrollUI) dodgeModule.darkenScreen();
              dodgeModule.playWarningStepVFX("alert 2 beat 1");
              _trace('[SAWBLADE] INCOMING DOUBLE!');
              _trace('[SAWBLADE] First Warning.');
              _trace('[SAWBLADE] HitTime: ${hitTimes[0]}');
              _trace('[SAWBLADE] HitTime: ${hitTimes[1]}');
            }
          },
          {
            beat: 1,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(2, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 2 beat 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, false);
              _trace('[SAWBLADE] Second Warning.');
            }
          },
          {
            beat: 2,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 2 attack 1");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 1, true);
              _trace('[SAWBLADE] Attack Double First!');
            }
          },
          {
            beat: 3,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(2, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 2 attack 2");
              _trace('[SAWBLADE] Attack Double Second!');
            }
          }
        ];
      
      case -1:
        [
          {
            beat: 0,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              if(!dodgeModule.useScrollUI) dodgeModule.darkenScreen();
              dodgeModule.playWarningStepVFX("alert 1 beat 1");
              _trace('[SAWBLADE] INCOMING FAKE SINGLE!');
              _trace('[SAWBLADE] First Warning.');
              //_trace('[SAWBLADE] HitTime: ${hitTimes[0]}');
            }
          },
          {
            beat: 1,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 1 beat 2");
              dodgeModule.doSawAnimation(false);
              if(dodgeModule.sawSprite != null){
                dodgeModule.sawSprite?.animation?.play('saw attack fail', true, false, 0);
                dodgeModule.sawSprite?.offset.x = 32;
              }
              //dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, false);
              _trace('[SAWBLADE] Second Warning.');
            }
          },
          {
            beat: 5,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              return;
            },
            callback: () ->
            {
              dodgeModule.activeEvents.remove(this.superClass);
              dodgeModule.hideAllVisuals();
              if(dodgeModule.useScrollUI){
                dodgeModule.undarkenScreen(false);
              }
              if(dodgeModule.sawSprite != null){
                dodgeModule.sawSprite.visible = true;
              }
            }
          }
        ];
      default:
        [
          {
            beat: 0,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              if(!dodgeModule.useScrollUI) dodgeModule.darkenScreen();
              dodgeModule.playWarningStepVFX("alert 1 beat 1");
              _trace('[SAWBLADE] INCOMING SINGLE!');
              _trace('[SAWBLADE] First Warning.');
              _trace('[SAWBLADE] HitTime: ${hitTimes[0]}');
            }
          },
          {
            beat: 1,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, false);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 1 beat 2");
              dodgeModule.executeAttack(this.superClass, Conductor.instance.stepLengthMs*stepTiming/Constants.MS_PER_SEC, 0, false);
              _trace('[SAWBLADE] Second Warning.');
            }
          },
          {
            beat: 2,
            triggeredCallbackAudio: false,
            triggeredCallback: false,
            callbackAudio: () ->
            {
              dodgeModule.playWarningStepSOUND(1, true);
            },
            callback: () ->
            {
              dodgeModule.playWarningStepVFX("alert 1 attack 1");
              _trace('[SAWBLADE] Attack Single!');
            }
          }
        ];
    }




    return seq;
  }





}
