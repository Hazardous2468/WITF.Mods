local function funnybounce(i)
	--set{i, -300, 'tiny', 100, 'zigzag'}
	--ease {i, 1, outQuad, 0, 'tiny', 0, 'zigzag'}
	ease {i, 1, flip(outQuad), -300, 'tiny', 100, 'zigzag'}
	
	add {i, 1, flip(outQuad), 36, 'glitch_line'}
	
	add {i, 1, outSine, 555, 'drunkoffset'}
	lazyalternator = not lazyalternator
	
	if lazyalternator then
		ease {i, 1, flip(outQuad), -45, 'noteskewy'}
		ease {i, 1, flip(outQuad), -45/2, 'skewx'}
		set{i, 100, 'wireframe'}
	else
		ease {i, 1, flip(outQuad), 45, 'noteskewy'}
		ease {i, 1, flip(outQuad), 45/2, 'skewx'}
		set{i, 0, 'wireframe'}
	end
end
