func_ease {256-96, 400, linear, 0.0, 360*11, function(a)
	ring1:rotationz(a)
	ring2:rotationz((a*-1)+22)
end}
local function rings(i)
	func_ease {i+1, 6.0, linear, 0.0, 2.0, function(a)
		ring1:zoom(a)
	end}
	func_ease {i+1, 1.0, linear, 0.0, 0.3, function(a)
		ring1:diffusealpha(a)
	end}
	func_ease {i+2, 4.5, linear, 0.3, 0.0, function(a)
		ring1:diffusealpha(a)
	end}
	
	func_ease {i+1+4, 6.0, linear, 0.0, 2.0, function(a)
		ring2:zoom(a)
	end}
	func_ease {i+1+4, 1.0, linear, 0.0, 0.3, function(a)
		ring2:diffusealpha(a)
	end}
	func_ease {i+2+4, 4.5, linear, 0.3, 0.0, function(a)
		ring2:diffusealpha(a)
	end}
end
for i = 256-96, 287-96, 8 do	
	rings(i)
end
for i = 296-96, 320-8-96, 8 do	
	rings(i)
end

