for i = 32, 96-8, 8 do
	if i < 96-8 then
		ease {i+7, 0.5, outQuad, 50, 'flip'}
		ease {i+8, 0.5, outQuad, 0, 'flip'}
		ease {i+7, 0.5, outQuad, 100, 'dark'}
		ease {i+8, 0.5, outQuad, 0, 'dark'}
		ease {i+7, 0.5, outQuad, 90, 'stealth'}
		ease {i+8, 0.5, outQuad, 0, 'stealth'}
	end
	
	ease {i, 0.5, outQuad, 100, 'beat'}
	ease {i+6.5, 0.5, linear, 0, 'beat'}
	add {i, 7, linear, -360*2*r, 'confusionzoffset0', 360*2*r, 'confusionzoffset1', -360*2*r, 'confusionzoffset2', 360*2*r, 'confusionzoffset3'}
	
	funnybounce(i)
	funnybounce(i+3.5)
	funnybounce(i+4)
	funnybounce(i+5.5)
	funnybounce(i+7)
end

