local topPlayer=1
local backPlayer=2


function RealFov(fov)
    return 360 / math.pi * math.atan(math.tan(math.pi * fov / 360) * sw / sh * 0.75)
end


P[backPlayer]:fov(0)
aftspritesholder:fov(RealFov(45))
topholder_outer:fov(RealFov(45))
ringContainer:fov(RealFov(45))
P[topPlayer]:fov(RealFov(45))




function transparentaft(self)
    self:SetWidth(dw)
    self:SetHeight(dh)
    self:EnableDepthBuffer(false)
    self:EnableAlphaBuffer(true)
    self:EnableFloat(false)
    self:EnablePreserveTexture(true)
    self:Create()
end
transparentaft(mainaft)

local aftsprites = aftspritesholder:GetChildren()
local howMany = 28
local howManyREAL = 32

local zoomAmount = 1.4
local zoomModAmount = (1+(1-zoomAmount))*100
setdefault{zoomModAmount, "zoom"}

for i,outer in ipairs(aftsprites) do
	local ir = howMany-i
	outer:y(sh*0.5)
	outer:x(sw*0.5)
	outer:zoom(zoomAmount)
	for _,v in ipairs(outer:GetChildren()) do
		sprite(v)
		v:SetTexture(mainaft:GetTexture())
		v:xy(0,0)	
		local a = i/howManyREAL
		--print(a)
		v:diffusealpha(a)
	end
end

topholder_outer:zoom(zoomAmount)
topholder_outer:x(sw*0.5)
topholder_outer:y(sh*0.5)
topholder_inner:y(sh*-0.5)
topholder_inner:x(sw*-0.5)

bottomholder_outer:zoom(zoomAmount)
bottomholder_outer:x(sw*0.5)
bottomholder_outer:y(sh*0.5)
bottomholder_inner:x(sw*-0.5)
bottomholder_inner:y(sh*-0.5)


definemod{'rotx', function(p)
	for i,outer in ipairs(aftsprites) do
		outer:rotationx(p*-1)
	end
	
	topholder_outer:rotationx(p*-1)
	bottomholder_outer:rotationx(p*-1)
	
	
	ring1:rotationx(p*-1)
	ring2:rotationx(p*-1)

end}


definemod{'roty', function(p)
	for i,outer in ipairs(aftsprites) do
		outer:rotationy(p*-1)
	end
	
	topholder_outer:rotationy(p*-1)
	bottomholder_outer:rotationy(p*-1)
	
	
	ring1:rotationy(p*-1)
	ring2:rotationy(p*-1)

end}

local bottomHoldZoffset = -256

definemod{'spacing', function(p)
	for i,outer in ipairs(aftsprites) do
		local ir = howMany-i
		for _,v in ipairs(outer:GetChildren()) do
			v:z(ir*-p)
		end
		--print("---")
		--print(i)
		--print(ir)
		--print("---")
	end
	local ir3 = howMany-33
	local zPosOfTop = (ir3)*-p
	topholder_inner:z(ir3*-p)
	
	ir3 = howMany/3
	zPosOfTop = (ir3)*-p
	bottomholder_inner:z((ir3*-p) + bottomHoldZoffset)
end}


func_ease {93, 3, outQuad, bottomHoldZoffset, 0, function(a)
	bottomHoldZoffset = a
end}

setdefault {0, 'spacing'}
ease{93, 3, outQuad, 4, "spacing"}

local xSpinMult = 0
local ySpinMult = 0

perframe {92, 286, function(a, poptions)
	local t = a*-2
	for i,outer in ipairs(aftsprites) do
		local ir = howManyREAL-i
		for _,v in ipairs(outer:GetChildren()) do
			local m = ir / howManyREAL
			local x = math.sin(i * math.pi/2 + t)*m
			local y = math.cos(i * math.pi/2 + t)*m	
			v:xy(x * xSpinMult, y * ySpinMult)
		end
	end
end}

func_ease {192, 4, outQuint, 0, 64, function(a)
	xSpinMult=a
	ySpinMult=a
end}
func_ease {199, 1, outCubic, 64, 0, function(a)
	xSpinMult=a
	ySpinMult=a
end}

func_ease {224, 4, outQuint, 0, 32, function(a)
	xSpinMult=a
end}
func_ease {286, 0.1, instant, 0, 0, function(a)
	xSpinMult=a
	ySpinMult=a
end}


