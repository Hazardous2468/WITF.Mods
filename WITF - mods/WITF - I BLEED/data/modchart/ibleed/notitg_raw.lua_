definemod {'dpad', function(a, pn)
    P[pn]:SetXSpline(1,0,-a,600,-1)
    P[pn]:SetXSpline(1,3,a,600,-1)
    P[pn]:SetYSpline(1,1,a,600,-1)
    P[pn]:SetYSpline(1,2,-a,600,-1)
end}



