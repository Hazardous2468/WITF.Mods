package witf.modules.play;

import funkin.modding.module.Module;
import funkin.play.PlayState;
import flixel.FlxG;
import funkin.util.Constants;
import funkin.Preferences;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.Conductor;
import funkin.play.notes.Strumline;
import flixel.math.FlxMath;
import flixel.util.FlxStringUtil;
import funkin.data.event.SongEventRegistry;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.Paths;
import flixel.ui.FlxBar;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.ui.debug.charting.ChartEditorState;
import funkin.play.PauseSubState;
import funkin.Highscore;
import funkin.modding.module.ModuleHandler;
import funkin.play.Countdown;



class ModchartDebug_HotKeys extends Module
{
	//starting with botplay now moved to meta Mods!

	var enableTimeManipulation:Bool = true;
	var skipToEndOffset = 10000; //10 seconds off
	var beatOffsetShiftMult = 3;
	var beatOffsetAmount = 2;
	var timeManipulateInBeats:Bool = true;
	
	//if true, will try to snap to the nearest beat! [A bit experimental right now]
	var snapToBeat:Bool = true;

	public function new() {
        super("ModchartDebug_HotKeys");	
    }
	
	var enabled:Bool = true;
	override function onCountdownStart(event) {
		super.onCountdownStart(event);

		var optionsModule = ModuleHandler.getModule("ModchartDebug_OptionsCategory");
		if(optionsModule!=null){
			enabled = optionsModule.getSaveData_DebugHotkeys();
		}else{
			trace("[DEBUG HOTKEYS] Options Module could not be found.");
		}
	}
	
	public function setSongTime(time:Float, resetEvents:Bool = false)
	{
		if(FlxG.sound.music == null) return;
		var game = PlayState.instance;
		if(game == null) return;
		//if(time < 0) time = 0;
		
		
		if(snapToBeat){
			var beatTime:Float = Conductor.instance.getTimeInSteps(time) / Constants.STEPS_PER_BEAT;
			trace("target beatTime: " + beatTime);
			beatTime = Math.fround(beatTime);
			time = Conductor.instance.getBeatTimeInMs(beatTime);
			trace("target ROUNDED beatTime: " + beatTime);
		}

		var goingBackwards:bool = Conductor.instance.songPosition > time;
		trace("Going Backwards? " + goingBackwards);

		FlxG.sound.music.pause();
		if (game.vocals != null) {
			game.vocals.pause();
		}

		FlxG.sound.music.time = time;
		FlxG.sound.music.pitch = game.playbackRate;
		
		if(!game.isGamePaused){
			FlxG.sound.music.play();
		}
		
		if (game.vocals != null) {
			//vocals.time = time;
			if (Conductor.instance.songPosition <= game.vocals.length)
			{
				game.vocals.time = time;
				game.vocals.pitch = game.playbackRate;
			}
			if(!game.isGamePaused){
				game.vocals.play();
			}
		}
		Conductor.instance.songPosition = time;
		
		game.handleSkippedNotes();

		Conductor.instance.update();		
		
		//Reset score to prevent cheating!
		game.health = Constants.HEALTH_STARTING;
		game.songScore = 0;
		Highscore.tallies.combo = 0;
		
		if(goingBackwards){
			//game.cameraBopIntensity = Constants.DEFAULT_BOP_INTENSITY;
	      	//game.hudCameraZoomIntensity = (game.cameraBopIntensity - 1.0) * 2.0;
	      	//game.cameraZoomRate = Constants.DEFAULT_ZOOM_RATE;
	      	//if (currentStage != null) currentStage.resetStage();
	      	//game.currentStage?.getBoyfriend()?.initHealthIcon(false);
      		//game.currentStage?.getDad()?.initHealthIcon(true);
      		if(resetEvents){
			    SongEventRegistry.resetEvents(game.songEvents);

			    // Fix for HazWired Sawblades 
			    var sawbladeDodgeModule = ModuleHandler.getModule("SawbladeAndDodgeModule_HazardVersion");
				if(sawbladeDodgeModule!=null){
					sawbladeDodgeModule.resetState();
				}
			}
		}

		SongEventRegistry.handleSkippedEvents(game.songEvents, Conductor.instance.songPosition);
	}
	
		
	function updatePraticeState(newVal:Bool){
		PlayState.instance.isPracticeMode = newVal;
		
		var subState = FlxG.state.subState;
		if (Std.isOfType(subState, PauseSubState)) {
			subState.updateMetadataText();
		}
	}
	
	function updateBotplayState(newVal:Bool){
		PlayState.instance.isBotPlayMode = newVal;
		PlayState.instance.updateScoreText();
	}

	
	
	function onUpdate(callback)
	{
		
		if(PlayState.instance == null || !enabled){ 
			return;
		}

		if (PlayState.instance.isGamePaused)
		{	
			//MAKE SURE WE'RE IN PAUSE SUBSTATE
			var subState; 
			if(PlayState.instance != null){
				subState = PlayState.instance.subState;
			}else{
				subState = FlxG.state.subState;
			}
			
			if (Std.isOfType(subState, PauseSubState)) {
				if (FlxG.keys.justPressed.FIVE){ 
					updatePraticeState(!PlayState.instance.isPracticeMode);
					FunkinSound.playOnce(Paths.sound(PlayState.instance.isPracticeMode ? "pauseEnable" : "pauseDisable"), 0.6);
				}
				if (FlxG.keys.justPressed.FOUR){ 
					updateBotplayState(!PlayState.instance.isBotPlayMode);
					FunkinSound.playOnce(Paths.sound(PlayState.instance.isBotPlayMode ? "pauseEnable" : "pauseDisable"), 0.6);
				}
			}			
		}

		//TIME SKIP LOGIC
		// Only works if you're in practice or botplay, timeManipulation is enabled, AND we are NOT in a countdown.
		if((PlayState.instance.isPracticeMode || PlayState.instance.isBotPlayMode) && enableTimeManipulation) { 

			if(Countdown.countdownTimer != null && !Countdown.countdownTimer.finished){
				//trace("Cannot time travel with an active countdown!");
				return;
			}

			// For some reason, the vwoosh timer will just randomly come alive and prevent us from time warping???
			// So just... try not to skip around when a vwoosh happens please
			//if(PlayState.instance.vwooshTimer != null){
			//	if(!PlayState.instance.vwooshTimer.finished && PlayState.instance.vwooshTimer.active){
			//		trace("Cannot time travel with an active vwooshTimer!");
			//		return;
			//	}
			//}
			


			if (FlxG.keys.justPressed.FOUR && !PlayState.instance.isGamePaused){ 
				setSongTime(PlayState.instance.startTimestamp, true);
			}
			
			if (FlxG.keys.justPressed.FIVE && !PlayState.instance.isGamePaused){ 
				setSongTime(PlayState.instance.currentSongLengthMs - skipToEndOffset);
			}
		
			if(FlxG.keys.justPressed.TWO){
			
				var gotoPos = Conductor.instance.songPosition;
				var posChange = 0;
				
				if(timeManipulateInBeats){
					var beatTime = Conductor.instance.beatLengthMs;
					posChange = beatTime * (FlxG.keys.pressed.SHIFT ? beatOffsetAmount*beatOffsetShiftMult : beatOffsetAmount); 
				}else{
					posChange = FlxG.keys.pressed.SHIFT ? 10000 : 5000;
				}
				
				if(FlxG.keys.pressed.CONTROL){
					posChange *= -1;
				}
				
				setSongTime(gotoPos + posChange, FlxG.keys.pressed.SHIFT);
			}
		}
		
		
		
	}

}