package witf.modules.charSelect;
import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.graphics.ZSpriteProjected;
import funkin.graphics.ScriptedZSpriteProjected;
import funkin.graphics.shaders.HSVNotesShader;


class ArrowParticleSprite extends ScriptedZSpriteProjected
{
  public var velocity_angleX:Float = 0;
  public var velocity_angleY:Float = 0;
  public var velocity_angleZ:Float = 0;
  public var velocity_y:Float = 0;
  public var velocity_x:Float = 0;

  public var hsvShader:HSVNotesShader;

  public function new(x:Float, y:Float)
  {
    super(x, y/*, Paths.image("arrowParticles/noteParticle" + FlxG.random.int(1, 6)) */ );

    this.frames = Paths.getSparrowAtlas('arrowParticles'); 
    this.animation.addByPrefix('1', '1', 24, true);  
    this.animation.addByPrefix('2', '2', 24, true);  
    this.animation.addByPrefix('3', '3', 24, true);  
    this.animation.addByPrefix('4', '4', 24, true);  
    this.animation.addByPrefix('5', '5', 24, true);  
    this.animation.addByPrefix('6', '6', 24, true);  
    this.animation.addByPrefix('7', '7', 24, true);  
    this.animation.play(FlxG.random.int(1, 7));

    hsvShader = new HSVNotesShader();
    this.shader = hsvShader;
    this.scale.set(0.75, 0.75);
  }

  public override function update(elapsed:Float):Void
  {
    super.update(elapsed);
    hsvShader.hue += elapsed*0.1;
  }

  public function spawn(freeplay:Bool = false, doTrails:Bool = false):Void{

    this.animation.play(FlxG.random.int(1, 7));
    hsvShader.hue = FlxG.random.float(-180.0,180.0);
    this.visible = true;

    this.angle = FlxG.random.float(-180, 180);
    if(freeplay)
    {
      this.x = FlxG.random.float(-120, FlxG.width*0.2);
      this.y = (this.height*-1.0)-96;
      if(!doTrails) this.z = FlxG.random.float(-250, 70);

      velocity_x = FlxG.random.float(-10, 10);
      velocity_y = FlxG.random.float(100, 260);

      if(!doTrails) {
        velocity_angleX = FlxG.random.float(-50, 50);
        velocity_angleY = FlxG.random.float(-50, 50);
      }
      velocity_angleZ = FlxG.random.float(-50, 50);
    }
    else
    {

      screenCenter();
      this.x = FlxG.width + 160;
      this.y += FlxG.random.float(FlxG.height*-0.45, FlxG.height*0.175);
      this.z = FlxG.random.float(-250, 100);

      velocity_x = FlxG.random.float(-260, -100);
      velocity_y = FlxG.random.float(-5, 5);

      velocity_angleX = FlxG.random.float(-50, 50);
      velocity_angleY = FlxG.random.float(-50, 50);
      velocity_angleZ = FlxG.random.float(-50, 50);

    }
  }
}
