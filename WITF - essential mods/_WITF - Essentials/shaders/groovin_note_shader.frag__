#pragma header

// A modified version of the WITF Hue Shift shader for the Groovin note style as it has a special gradient animation.

uniform float _animationProgress;


uniform float _hue;
uniform float _sat;
uniform float _val;
uniform float _hue2;
uniform float _sat2;
uniform float _val2;
uniform float _stealthGlow;
uniform float _stealthR;
uniform float _stealthG;
uniform float _stealthB;

uniform bool _isHold;
uniform float _holdHeight;
uniform float _stealthSustainSuddenStart;
uniform float _stealthSustainSuddenEnd;
uniform float _stealthSustainHiddenStart;
uniform float _stealthSustainHiddenEnd;
uniform float _stealthSustainSuddenAmount;
uniform float _stealthSustainHiddenAmount;
uniform float _stealthSustainSuddenNoGlow;
uniform float _stealthSustainHiddenNoGlow;
uniform float _stealthSustainVanish_SuddenStart;
uniform float _stealthSustainVanish_SuddenEnd;
uniform float _stealthSustainVanish_HiddenStart;
uniform float _stealthSustainVanish_HiddenEnd;
uniform float _stealthSustainVanishAmount;
uniform float _stealthSustainVanishNoGlow;



vec3 normalizeColor(vec3 color)
{
    return vec3(
        color[0] / 255.0,
        color[1] / 255.0,
        color[2] / 255.0
    );
}

vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void main() {
	vec4 color = flixel_texture2D(bitmap, openfl_TextureCoordv);
	
	// Red should become 239, 191, 191 for consistency with the original design.

	// Green and Blue are used to control the gradient animation based of _animationProgress (0 = on beat, no change as a reference point)
	// the progress then shifts the gradient.

	// Recolour the gradient so that bright is 255,0,0 and dark is 175,0,0


	// The end result should be something that is only red for the hue shift / quantisation colours to work properly.

	float gradCoord  = color.g;
    float fillMask   = color.b;

	float animated = fract(gradCoord + _animationProgress);

	float bright = 1.0;
    float dark   = 175.0 / 255.0;
    float gradientValue = mix(dark, bright, animated);


    float borderValue = 239.0 / 255.0;
    float finalRed = mix(borderValue, gradientValue, fillMask);

    color.rgb = vec3(finalRed, 0.0, 0.0);


	// The rest is just the standard WITF Hue Shift shader.


	vec4 swagColor = vec4(rgb2hsv(vec3(color[0], color[1], color[2])), color[3]);
	swagColor.x += _hue + _hue2;
	swagColor.y *= _sat * _sat2;
	swagColor.z *= _val * _val2;
	color = vec4(hsv2rgb(vec3(swagColor[0], swagColor[1], swagColor[2])), swagColor[3]);
	
	vec4 glow = vec4(_stealthR,_stealthG,_stealthB, 1.0);	
	float _stealthGlow_clamped = clamp(_stealthGlow, 0.0, 1.0);
	glow *=  color[3]; //Apply Alpha from texture
	glow = clamp(glow, 0.0, 1.0);

	color = mix(color, glow, _stealthGlow_clamped);

	gl_FragColor = color;

}

